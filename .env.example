GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_DIM=3072
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_CLOUD_URI=
NEO4J_CLOUD_USERNAME=
NEO4J_CLOUD_PASSWORD=
NEO4J_CLOUD_DATABASE=
NEO4J_TARGET=cloud                # local | cloud
# W1.3 env matrix — Render owns the API, Vercel hosts the frontend only.
# APP_ENV=prod refuses to boot unless API_URL is an https:// origin.
APP_ENV=dev                      # dev | prod
API_URL=http://localhost:8000    # prod: https://<render-api>.onrender.com
FRONTEND_URL=http://localhost:5173  # prod: https://<vercel-app>.vercel.app
DATABASE_URL=                    # Neon Postgres (W1.4) — canonical PG input; backend bridges it into POSTGRES_* at boot
# Optional POSTGRES_* overrides (bridge fills any that are absent; never clobbered when set):
#POSTGRES_HOST=
#POSTGRES_PORT=5432
#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DATABASE=
#POSTGRES_SSL_MODE=require        # Neon mandates TLS
# Pooled (pgbouncer) URLs: open the asyncpg pool with statement_cache_size=0.
REDIS_URL=                       # Redis for the indexing queue (W1.4)
LLM_PROVIDER=stub                # gemini (primary) | groq (fallback) | stub (dev)
LLM_LIVE=0                       # 1 = allow live LLM calls; default 0 = cache-first
CACHE_MODE=preindex-only         # preindex-only | live-allowed
CRON_SECRET=                     # bearer token for the Render keepalive cron (W1.4)
# Dev-only Ollama opt-in. Leave empty in prod (Ollama calls raise there).
# Local dev loopback default: http://localhost:11434
OLLAMA_BASE_URL=
PRIMARY_LLM_PROVIDER=gemini       # groq | gemini | ollama

EMBED_PROVIDER=gemini        # gemini (3072-dim) | ollama (768-dim, delete rag_storage/ to switch)

# MongoDB Atlas (for VDB + KV + Doc Status storage)
MONGO_URI=
MONGO_DATABASE=nyayamitra
